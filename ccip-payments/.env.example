# Run all commands from ccip-payments. Do not reuse production keys for testing.
CHAIN_ENV=testnet
HUB_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
SOURCE_RPC_URL=https://sepolia.base.org
SOURCE_NETWORK=ethereum-testnet-sepolia-base-1
# Optional: deploy script saves Hub address to ignored deployments.local.json.
HUB_ADDRESS=
OWNER_PRIVATE_KEY=YOUR_TESTNET_OWNER_PRIVATE_KEY
PAYER_PRIVATE_KEY=YOUR_TESTNET_PAYER_PRIVATE_KEY
# Broadcasting is blocked until explicitly enabled.
ALLOW_TESTNET_TRANSACTIONS=false
ALLOW_MAINNET_TRANSACTIONS=no
ORDER_ID=1001
ORDER_TOKEN=USDC
ORDER_AMOUNT=10
# Staking: first fund rewards on Hub, then register a NEW order for 100 principal.
BENEFICIARY_ADDRESS=YOUR_PAYER_ADDRESS
REWARD_AMOUNT=10
LOCK_SECONDS=604800
